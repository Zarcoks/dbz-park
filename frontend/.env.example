# Copier ce fichier en `.env` et adapter si besoin.

# Racine de l'API. Par défaut /api, que Vite renvoie vers http://localhost:8000
# (voir le proxy dans vite.config.js). En production, mettre l'URL publique du
# back, par exemple https://api.dbz-park.fr/api
VITE_API_URL=/api

# true  : l'application tourne sur des fausses données (src/api/mock.js),
#         sans aucun back. C'est le mode par défaut tant que l'API n'existe pas.
# false : les appels partent pour de vrai vers VITE_API_URL.
VITE_USE_MOCK=true
